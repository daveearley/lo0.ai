---
/** The install command for each platform, switched with radio buttons so it works without JavaScript. */
import CopyCommand from './CopyCommand.astro';
import { site } from '../site';

interface Props { name: string }
const { name } = Astro.props;

const ways = [
  { id: 'unix', label: 'macOS · Linux', command: site.install.unix, note: 'Downloads the release for your machine, checks it against the published checksum and installs it to ~/.local/bin.' },
  { id: 'windows', label: 'Windows', command: site.install.windows, note: 'In PowerShell. Installs to %LOCALAPPDATA%\\Programs\\lo0 and adds it to your PATH.' },
  { id: 'go', label: 'Go', command: site.install.go, note: `Builds from source. Needs Go ${site.goVersion} or newer.` },
];
---
<div class="install-tabs">
  <fieldset class="tabs">
    <legend class="visually-hidden">Platform</legend>
    {ways.map((w, i) => (
      <label><input type="radio" name={name} value={w.id} checked={i === 0} /><span>{w.label}</span></label>
    ))}
  </fieldset>
  {ways.map((w) => (
    <div class="way" data-way={w.id}>
      <CopyCommand command={w.command} label="Install" />
      <p class="note">{w.note}</p>
    </div>
  ))}
</div>

<style>
  .install-tabs { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.7rem; min-width: 0; }

  .tabs {
    display: flex;
    gap: 0.25rem;
    border: 0;
    padding: 0;
    font-size: var(--step--1);

    & label { position: relative; cursor: pointer; }
    & input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
    & span {
      display: block;
      padding: 0.3rem 0.75rem;
      border-radius: 999px;
      color: var(--ink-3);
      transition: color 160ms, background-color 160ms;
    }
    & label:hover span { color: var(--ink); }
    & input:checked + span { color: var(--ink); background: var(--bg-sunk); box-shadow: inset 0 0 0 1px var(--rule); }
    & input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  }

  .way { display: none; grid-template-columns: minmax(0, 1fr); gap: 0.6rem; min-width: 0; }
  .install-tabs:has(input[value='unix']:checked) [data-way='unix'],
  .install-tabs:has(input[value='windows']:checked) [data-way='windows'],
  .install-tabs:has(input[value='go']:checked) [data-way='go'] { display: grid; }

  .note { font-size: var(--step--1); color: var(--ink-3); }
</style>
