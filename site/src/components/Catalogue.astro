---
import catalog from '../../../internal/catalog/catalog.json';

type Model = (typeof catalog.models)[number];
const tiers = ['A', 'B', 'C', 'D'] as const;
const order = (m: Model) => tiers.indexOf(m.tier as (typeof tiers)[number]);
const models = [...catalog.models].sort((a, b) => order(a) - order(b) || a.params - b.params);
const present = tiers.filter((t) => models.some((m) => m.tier === t));

const billions = (n: number) => {
  const b = n / 1e9;
  return b >= 100 ? `${Math.round(b)}B` : `${b.toFixed(1).replace(/\.0$/, '')}B`;
};
// The card's own active count where it states one; lo0's derived count also
// includes embedding tables.
const active = (m: Model) => ('statedActiveParams' in m && m.statedActiveParams ? (m.statedActiveParams as number) : m.activeParams);
const ctx = (n: number) => (n >= 1024 * 1024 ? `${Math.round(n / (1024 * 1024))}M` : `${Math.round(n / 1024)}k`);
const licence = (l: string) => (l === 'other' ? 'custom licence' : l);
const total = models.length;
const css = present
  .map((t) => `.cat:has(input[value='${t}']:checked) .list li:not([data-tier='${t}']){display:none}`)
  .join('');
---
<div class="cat">
  <style is:inline set:html={css}></style>

  <div class="bar">
    <fieldset>
      <legend class="visually-hidden">Filter by tier</legend>
      <div class="opts">
        <label><input type="radio" name="cat-tier" value="all" checked /><span>All {total}</span></label>
        {present.map((t) => (
          <label><input type="radio" name="cat-tier" value={t} /><span>Tier {t}</span></label>
        ))}
      </div>
    </fieldset>
    <p class="note">Catalogue of {new Date(catalog.generated).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</p>
  </div>

  <ul class="list" role="list">
    {models.map((m) => (
      <li data-tier={m.tier}>
        <span class="name">{m.name}</span>
        <span class="spec tnum">
          {billions(m.params)}{m.activeParams < m.params && <span class="act"> · {billions(active(m))} active</span>}
          <span class="sep"> · </span>{ctx(m.contextLength)}
        </span>
        <span class="lic">{licence(m.license)}</span>
        <span class:list={['tier', `t-${m.tier}`]} title={m.tierNote}>{m.tier}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .cat { display: grid; gap: 1.5rem; }

  .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; }
  fieldset { border: 0; padding: 0; min-width: 0; max-width: 100%; }

  .opts {
    display: inline-flex;
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 3px;
    border-radius: 999px;
    background: var(--bg-sunk);
    border: 1px solid var(--rule);

    & label { position: relative; flex: none; }
    & input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
    & span {
      display: block;
      padding: 0.4rem 0.95rem;
      border-radius: 999px;
      font-size: 0.875rem;
      color: var(--ink-2);
      white-space: nowrap;
      transition: background-color 180ms, color 180ms, box-shadow 180ms;
    }
    & input:checked + span {
      background: var(--surface);
      color: var(--ink);
      box-shadow: 0 1px 2px oklch(20% 0.01 260 / 0.12), 0 0 0 1px var(--rule-strong);
    }
    & label:hover input:not(:checked) + span { color: var(--ink); }
    & input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  }

  .note { font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-3); }

  .list {
    columns: 2 26rem;
    column-gap: 3rem;
    column-rule: 1px solid var(--rule);
  }

  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'name tier' 'spec tier';
    column-gap: 1rem;
    break-inside: avoid;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--rule);

    @starting-style { opacity: 0; }
    transition: opacity 240ms;
  }

  .name { grid-area: name; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .spec { grid-area: spec; font-family: var(--font-mono); font-size: 0.78rem; color: var(--ink-3); }
  .lic { display: none; }

  .tier {
    grid-area: tier;
    align-self: center;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    border: 1px solid var(--rule-strong);
    color: var(--ink-2);
  }

  .t-A { background: var(--accent); border-color: transparent; color: var(--on-accent); }
  .t-B { background: var(--accent-soft); border-color: color-mix(in oklch, var(--accent) 35%, transparent); color: var(--accent); }
</style>
