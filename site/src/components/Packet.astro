---
/**
 * The lo0 mark at display size. As the section scrolls past, the dot travels
 * once round the 0 and stops where it started: sent, and straight back.
 */
---
<div class="packet" aria-hidden="true">
  <svg viewBox="0 0 128 128" class="ring">
    <path d="M64,25 A27,27 0 0 1 91,52 V80 A27,27 0 0 1 37,80 V52 A27,27 0 0 1 64,25 Z" pathLength="100" fill="none" stroke="currentColor" stroke-width="22" stroke-dasharray="81.2044 18.7956" stroke-dashoffset="81.2044" />
  </svg>
  <span class="dot"></span>
</div>

<style>
  .packet {
    --s: 1.25;
    --size: calc(128px * var(--s));
    position: relative;
    width: var(--size);
    aspect-ratio: 1;
    color: var(--ink);
  }

  @media (width >= 48rem) {
    .packet { --s: 2; }
  }

  .ring { width: 100%; height: 100%; overflow: visible; }

  .dot {
    position: absolute;
    left: 0;
    top: 0;
    width: 128px;
    height: 128px;
    scale: var(--s);
    transform-origin: 0 0;
    pointer-events: none;
  }

  .dot::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 26.4px;
    height: 26.4px;
    border-radius: 50%;
    background: var(--accent);
    offset-path: path('M83.09,32.91 A27,27 0 0 1 91,52 V80 A27,27 0 0 1 37,80 V52 A27,27 0 0 1 64,25 A27,27 0 0 1 83.09,32.91');
    offset-rotate: 0deg;
    offset-distance: 0%;

    @supports (animation-timeline: view()) {
      animation: loop linear both;
      animation-timeline: view();
      animation-range: cover 20% cover 80%;
    }
  }

  @keyframes loop {
    0%, 12% { offset-distance: 0%; }
    88%, 100% { offset-distance: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .dot::before { animation: none; }
  }
</style>
