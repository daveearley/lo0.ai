---
/**
 * Weights plus KV cache for six models of similar size and different
 * attention designs, at a chosen context length. The cache figures use the
 * same formula as the CLI.
 */
import Figure from './Figure.astro';
import { model, quant, kvBytes, kvPerToken, tokens, GiB, KiB } from '../../data/models';

const picks = [
  { id: 'devstral-small-2-24b', design: 'Dense · full attention' },
  { id: 'qwen3-coder-30b-a3b', design: 'MoE · full attention' },
  { id: 'glm-4.7-flash', design: 'MoE · latent attention' },
  { id: 'gemma-4-26b-a4b', design: 'MoE · mostly sliding window' },
  { id: 'qwen3.6-35b-a3b', design: 'MoE · hybrid DeltaNet' },
  { id: 'nemotron-3-nano-30b-a3b', design: 'MoE · hybrid Mamba' },
];
const contexts = [32, 128, 256];
const initial = 128;

const rows = picks.map((p) => {
  const m = model(p.id);
  const weights = quant(m, 'Q4_K_M').bytes;
  return {
    ...p,
    name: m.name,
    params: m.params,
    weights,
    perToken: kvPerToken(m),
    at: contexts.map((k) => {
      const n = Math.min(k * 1024, m.contextLength);
      return { k, capped: n < k * 1024 ? n : 0, kv: kvBytes(m, n) };
    }),
  };
});
const scale = Math.ceil(Math.max(...rows.flatMap((r) => r.at.map((a) => r.weights + a.kv))) / GiB / 10) * 10;
const pct = (b: number) => `${((b / GiB / scale) * 100).toFixed(2)}%`;
const gib = (b: number) => (b / GiB).toFixed(1);

const css = contexts
  .map((k, i) => {
    const on = `.ctx:has(input[value='${k}']:checked)`;
    return rows.map((r) => `${on} [data-m='${r.id}']{--kv:${pct(r.at[i].kv)}}`).join('') + `${on} [data-c='${k}']{display:inline}`;
  })
  .join('');
---
<Figure title="What context costs, model by model" for="kv-cache">
  <style is:inline set:html={css}></style>
  <div class="ctx">
    <fieldset>
      <legend>Context</legend>
      <div class="opts">
        {contexts.map((k) => (
          <label><input type="radio" name="ctx-len" value={k} checked={k === initial} /><span>{k}k tokens</span></label>
        ))}
      </div>
    </fieldset>

    <ul class="key" role="list" aria-hidden="true">
      <li><i class="k-w"></i>Weights at Q4_K_M</li>
      <li><i class="k-kv"></i>KV cache at f16</li>
    </ul>

    <ol class="rows" role="list">
      {rows.map((r) => (
        <li data-m={r.id}>
          <p class="who">
            <span class="name">{r.name}</span>
            <span class="design">{r.design} · {Math.round(r.perToken / KiB)} KiB a token</span>
          </p>
          <div class="mid">
            <span class="bar" aria-hidden="true">
              <span class="w" style={`width:${pct(r.weights)}`}></span>
              <span class="kv"></span>
            </span>
            <span class="detail tnum">
              {r.at.map((a) => (
                <span data-c={a.k}>
                  {gib(r.weights)} + {gib(a.kv)} GiB cache{a.capped ? ` (model max ${tokens(a.capped)})` : ''}
                </span>
              ))}
            </span>
          </div>
          <p class="total tnum">
            {r.at.map((a) => <span data-c={a.k}>{gib(r.weights + a.kv)} GiB</span>)}
          </p>
        </li>
      ))}
    </ol>
  </div>
  <Fragment slot="note">
    Six models of {Math.floor(Math.min(...rows.map((r) => r.params)) / 1e9)}–{Math.round(Math.max(...rows.map((r) => r.params)) / 1e9)}B
    parameters whose weights take {Math.floor(Math.min(...rows.map((r) => r.weights)) / GiB)}–{Math.ceil(Math.max(...rows.map((r) => r.weights)) / GiB)} GiB. Cache sizes come from each
    model’s config in lo0’s catalogue and include the fixed state of sliding-window, Mamba and DeltaNet
    layers. KiB a token is what each token adds once past any sliding window. An 8-bit cache halves the accent part.
  </Fragment>
</Figure>

<style>
  .ctx { display: grid; gap: 1.5rem; }
  [data-c] { display: none; }

  .key {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin-top: -0.5rem;
    font-size: 0.8125rem;
    color: var(--ink-2);

    & li { display: flex; align-items: center; gap: 0.45rem; }
    & i { width: 0.7rem; height: 0.7rem; border-radius: 2px; }
    & .k-w { background: var(--ink); }
    & .k-kv { background: var(--accent); }
  }

  .rows { display: grid; }

  .rows li {
    display: grid;
    grid-template-columns: minmax(0, 14rem) minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.4rem 1.25rem;
    padding-block: 0.8rem;
    border-top: 1px solid var(--rule);
  }

  .who { display: grid; line-height: 1.3; }
  .name { font-weight: 600; font-size: 0.9375rem; }
  .design { font-size: 0.8125rem; color: var(--ink-3); }

  .bar {
    display: flex;
    gap: 2px;
    height: 0.9rem;
    border-radius: 3px;
    background: var(--bg-sunk);
    overflow: hidden;

    & > span { display: block; height: 100%; border-radius: 3px; min-width: 2px; }
    & .w { background: var(--ink); flex: none; }
    & .kv { background: var(--accent); width: var(--kv); transition: width 500ms var(--ease-in-out); }
  }

  .mid { display: grid; gap: 0.35rem; min-width: 0; }
  .total { font-family: var(--font-mono); font-size: 1rem; font-weight: 500; text-align: end; white-space: nowrap; }
  .detail { font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-3); }

  @media (width < 44rem) {
    .rows li { grid-template-columns: minmax(0, 1fr) auto; }
    .mid { grid-column: 1 / -1; grid-row: 2; }
    .total { grid-row: 1; grid-column: 2; }
  }
</style>
