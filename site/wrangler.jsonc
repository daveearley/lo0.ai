{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lo0-site",
  "compatibility_date": "2026-11-01",
  "routes": [{ "pattern": "lo0.ai", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
